{
  "name": "@wapve/desktop",
  "version": "0.3.7",
  "private": true,
  "description": "Wapve Windows desktop client",
  "author": "Wapve",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "postinstall": "install-electron",
    "ui:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "ui:build": "tsc --noEmit && vite build",
    "electron:build": "tsc -p tsconfig.electron.json && node scripts/minify-electron.mjs",
    "test": "tsx --test electron/**/*.test.ts",
    "test:electron": "node scripts/electron-smoke.mjs",
    "dev": "pnpm ui:build && pnpm electron:build && electron .",
    "check": "pnpm ui:build && pnpm electron:build && pnpm test && pnpm test:electron",
    "dist:win": "pnpm check && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "terser": "5.50.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
